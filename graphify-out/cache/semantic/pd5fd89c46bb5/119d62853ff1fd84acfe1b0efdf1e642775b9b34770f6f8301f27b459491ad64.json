{"nodes": [{"id": "_impeccable_review_data_sources_mobile_2", "label": "Data Sources and Provenance Page (Mobile)", "file_type": "image", "source_file": ".impeccable/review/data-sources-mobile-2.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full-height mobile reference screenshot of the provenance page captured at 380x4602, used as the long-scroll baseline for the review pass. The page exists to answer 'what is rendered, what is simulated, and what is not' before any audio claim is made."}, {"id": "_impeccable_review_data_sources_mobile_2_three_layers_of_evidence", "label": "Three Layers of Evidence", "file_type": "concept", "source_file": ".impeccable/review/data-sources-mobile-2.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Design principle: separate what NASA produced (numerical field), what NASA rendered (image), and what this project derives (processed data), so a viewer can never mistake a pretty frame for a measurement. Layer 1 is explicitly not certified; only the rendered image carries 'certified'."}, {"id": "_impeccable_review_data_sources_mobile_2_numerical_field", "label": "Numerical Field (NASA Asset, Not Certified)", "file_type": "rationale", "source_file": ".impeccable/review/data-sources-mobile-2.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ECCO2 surface current (u, v) and sea surface temperature; 0.25 deg, daily mean 26 Mar 2007 - 03 Mar 2008 as NetCDF/Granule inputs. Declared 'not certified' here because the certification line applies to the visualization, not the field."}, {"id": "_impeccable_review_data_sources_mobile_2_rendered_visualization", "label": "Rendered Visualization (NASA Asset, Certified)", "file_type": "rationale", "source_file": ".impeccable/review/data-sources-mobile-2.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One frame of NASA SVS 3912, 2048x1024 JPEG, published 7 May 2008, credited Greg Shirah / NASA GSFC. Certified because NASA's published record is the authoritative artifact - the project does not re-render or re-derive it."}, {"id": "_impeccable_review_data_sources_mobile_2_derived_processed_data", "label": "Derived / Processed Data (NASA Asset, Derived)", "file_type": "rationale", "source_file": ".impeccable/review/data-sources-mobile-2.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reserved layer for sonified output and any rescaling the project itself performs. Declared up front so future audio/derived artifacts are never retrofitted into the 'raw' layers."}, {"id": "_impeccable_review_data_sources_mobile_2_sea_surface_temperature", "label": "Sea Surface Temperature Dataset", "file_type": "concept", "source_file": ".impeccable/review/data-sources-mobile-2.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_impeccable_review_data_sources_mobile_2_sea_surface_currents", "label": "Sea Surface Currents (u, v)", "file_type": "concept", "source_file": ".impeccable/review/data-sources-mobile-2.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_impeccable_review_data_sources_mobile_2_ecco2_mitgcm", "label": "ECCO2 - MITgcm Model", "file_type": "concept", "source_file": ".impeccable/review/data-sources-mobile-2.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ECCO2 is a data-assimilating model output, not an observation - the page states 'data-assimilating model not direct measurement'. This is the single most load-bearing honesty claim on the page."}, {"id": "_impeccable_review_data_sources_mobile_2_svs_3912", "label": "NASA SVS 3912 Source Record", "file_type": "concept", "source_file": ".impeccable/review/data-sources-mobile-2.png", "source_location": null, "source_url": null, "captured_at": null, "author": "Greg Shirah", "contributor": null}, {"id": "_impeccable_review_data_sources_mobile_2_source_record_ledger", "label": "Source Record Ledger (Every Claim Traced)", "file_type": "rationale", "source_file": ".impeccable/review/data-sources-mobile-2.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rule stated on-page: 'every row below was checked against its publisher' and 'The last two rows are explicitly not part of this build.' Rows are grouped NASA SVS (3912, high-res, EECO2 derived still), ECCO2 (product overview, numerical fields), EECO2 PODAAC, plus NASA/ECCO2 licensing and FAS citation links."}, {"id": "_impeccable_review_data_sources_mobile_2_image_can_and_cannot_show", "label": "What the Image Can and Cannot Show", "file_type": "rationale", "source_file": ".impeccable/review/data-sources-mobile-2.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two-column honest-limits table. CAN SHOW: spatial pattern of modelled surface current flow, season and basin-scale currents, where warm currents and eddies appear, one depiction near 2007-2008. CANNOT SHOW: singular temperature values, numerical velocity, unlabelled uncertainty, a live ocean, and precise place-level conditions (only ocean-basin scale)."}, {"id": "_impeccable_review_data_sources_mobile_2_access_limitations_and_next_step", "label": "Access Limitations and Next Step", "file_type": "rationale", "source_file": ".impeccable/review/data-sources-mobile-2.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explains that numerical-field access is not free via API, requires training/specialist support, and needs an Earthdata login or API credentials - plus a size caveat (the dataset is far larger than a single browser session, so it will be subset/chunked). This is the stated blocker for Stage 02."}, {"id": "_impeccable_review_data_sources_mobile_2_licensing_and_attribution", "label": "Licensing and Attribution", "file_type": "rationale", "source_file": ".impeccable/review/data-sources-mobile-2.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NASA imagery is public domain but NASA does not endorse the project; ECCO2 products carry a citation condition and the derived output inherits it. Footer restates: 'Independent project. Not an official NASA product.'"}, {"id": "_impeccable_review_data_sources_mobile_2_citation_block", "label": "Citation Block", "file_type": "concept", "source_file": ".impeccable/review/data-sources-mobile-2.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_impeccable_review_data_sources_mobile_2", "target": "_impeccable_review_data_sources_mobile_2_three_layers_of_evidence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".impeccable/review/data-sources-mobile-2.png", "source_location": null, "weight": 1.0}, {"source": "_impeccable_review_data_sources_mobile_2", "target": "_impeccable_review_data_sources_mobile_2_source_record_ledger", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".impeccable/review/data-sources-mobile-2.png", "source_location": null, "weight": 1.0}, {"source": "_impeccable_review_data_sources_mobile_2", "target": "_impeccable_review_data_sources_mobile_2_image_can_and_cannot_show", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".impeccable/review/data-sources-mobile-2.png", "source_location": null, "weight": 1.0}, {"source"