{"nodes": [{"id": "product_listen_to_what_you_cannot_see", "label": "Tagline: Listen to What You Cannot See", "file_type": "concept", "source_file": "PRODUCT.md", "source_location": "Brand Commitments", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "product_brand_commitments", "label": "Brand Commitments (Earth's Pulse, NASA attribution)", "file_type": "document", "source_file": "PRODUCT.md", "source_location": "Brand Commitments", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The brief pins the visual world (near-black navy ground, restrained cyan accents, Inter for reading, mono for measurements, no glassmorphism, no neon, no emoji). NASA attribution is mandatory and must distinguish NASA's visualization from this independent, non-endorsed challenge project."}, {"id": "product_stack", "label": "Product Stack (Next.js App Router, React, TS strict, Tailwind)", "file_type": "document", "source_file": "PRODUCT.md", "source_location": "Platform / Stack", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scientific preprocessing will be Python/NumPy/xarray later, so the TypeScript data model stays UI-independent and serializable; Canvas/SVG only when a visual overlay needs it, with no Three.js or 3D globe in Stage 1."}, {"id": "product_stage_1_scope", "label": "Stage 1 Scope (visual foundation only)", "file_type": "document", "source_file": "PRODUCT.md", "source_location": "Capabilities and Constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately ends at the verified metadata plus one rendered still: no numerical ECCO2 fields, no sonification engine, and no claim that pixel colors are measurements, because faking a subsystem would violate the product's honesty principle."}, {"id": "product_product_principles", "label": "Product Principles (five)", "file_type": "document", "source_file": "PRODUCT.md", "source_location": "Product Principles", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "product_science_before_spectacle", "label": "Science Before Spectacle", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": "Product Principles 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A beautiful interface that blurs provenance is a failure."}, {"id": "product_provenance_is_part_of_the_interface", "label": "Provenance Is Part of the Interface", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": "Product Principles 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The visitor can always tell what is measured, modeled, rendered, or derived; original scientific data, NASA's rendering, and derived/normalized data are named as different things."}, {"id": "product_never_fake_measurement", "label": "Never Fake a Measurement or a Control", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": "Product Principles 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unavailable systems are labeled, not simulated; a disabled control must show the reason it cannot be used."}, {"id": "product_audio_equal_access_path", "label": "Audio Is an Equal Access Path", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": "Product Principles 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sonification is an interpretation of data, not an atmosphere; the product exists because visual-only science excludes people, so future audio must ship with equivalent textual state and never sound alone."}, {"id": "product_smallest_trustworthy_system", "label": "Build the Smallest Trustworthy System That Can Grow", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": "Product Principles 5", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "product_listen_to_what_you_cannot_see", "target": "product_brand_commitments", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": "Brand Commitments", "weight": 1.0}, {"source": "product_brand_commitments", "target": "design_calibrated_plate", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "PRODUCT.md", "source_location": "Brief-pinned visual world becomes the design system", "weight": 1.0}, {"source": "product_stage_1_scope", "target": "docs_architecture_audio_boundary", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "PRODUCT.md", "source_location": "Explicitly not implemented: sonification engine, playback, synchronization", "weight": 1.0}, {"source": "product_science_before_spectacle", "target": "product_product_principles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": "Product Principles 1", "weight": 1.0}, {"source": "product_provenance_is_part_of_the_interface", "target": "product_product_principles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": "Product Principles 2", "weight": 1.0}, {"source": "product_never_fake_measurement", "target": "product_product_principles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": "Product Principles 3", "weight": 1.0}, {"source": "product_audio_equal_access_path", "target": "product_product_principles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": "Product Principles 4", "weight": 1.0}, {"source": "product_smallest_tru