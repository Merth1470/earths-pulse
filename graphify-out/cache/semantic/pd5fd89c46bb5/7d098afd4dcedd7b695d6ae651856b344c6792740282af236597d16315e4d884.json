{"nodes": [{"id": "design_calibrated_plate", "label": "The Calibrated Plate (Design North Star)", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "Overview", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The system borrows composure from research charts and observatory consoles so the ocean image can carry the page while provenance can interrupt the mood without feeling bolted on. It explicitly refuses the dark neon dashboard, glass panels, gradient spectacle, hero metrics, and fake charts that would make an unavailable scientific system look finished."}, {"id": "design_one_signal_rule", "label": "The One Signal Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "Colors > Named Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cyan means available or active, amber means blocked or incomplete, neutral grey means pending; these hues are never decoration. Availability must never be communicated by color alone."}, {"id": "design_hairline_rule", "label": "The Hairline Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "Colors > Named Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Structure is drawn with 1px rules and tonal shifts rather than rounded cards, glass, or panel shadows, which keeps the plate the only elevated object."}, {"id": "design_measurement_mono_rule", "label": "The Measurement Mono Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "Typography > Named Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IBM Plex Mono is reserved for things that were looked up, measured, or timed (identifiers, coordinates, timestamps, units, machine status), which keeps prose in Inter and prevents the mono face from becoming decorative."}, {"id": "design_quiet_heading_rule", "label": "The Quiet Heading Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "Typography > Named Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_single_lift_rule", "label": "The Single Lift Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "Elevation & Depth > Named Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Depth is tonal by default; only the visualization plate casts a shadow so it reads as mounted above the page without turning panels into floating cards."}, {"id": "design_instrument_cyan", "label": "Instrument Cyan (#42c7d9)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "Colors > Primary", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reserved for meaning and interaction (links, focus, available status, loading progress) and never used as a background wash."}, {"id": "design_plate_lift", "label": "Plate Lift Shadow", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "Elevation & Depth > Shadow Vocabulary", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_visualization_plate", "label": "Visualization Plate Component", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "Components > Visualization Plate", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A strict 2:1 rectangle with four 9px cyan corner ticks and the only shadow in the product; loading and error states never lose the caption or source credit so provenance survives failure."}, {"id": "design_sonification_transport", "label": "Sonification Transport Component", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "Components > Sonification Transport", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The entire transport is offline in Stage 1: play, speed, and layer controls are disabled and visible copy names the missing engine and numerical fields instead of simulating activity."}, {"id": "design_source_record", "label": "Source Record Panel", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "Components > Source Record", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_status_marks", "label": "Status Marks (dot plus word)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "Components > Status Marks", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_no_pixel_sampling_as_measurement", "label": "Rule: Never Sample Rendered Pixels as Measurements", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "Do's and Don'ts > Don't", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The plate is a rendered visualization, not numerical data; sampling pixel colors would convert a rendering choice into invented measurements and imply data the project does not have."}], "edges": [{"source": "design_calibrated_plate", "target": "design_one_signal_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md", "source_location": "Overview key characteristics", "weight": 1.0}, {"source": "design_calibrated_plate", "target": "design_hairline_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md", "source_location": "Overview key characteristics", "weight": 1.0}, {"source": "design_calibrated_plate", "target": "design_measurement_mono_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md", "source_location": "Overview key characteristics", "weight": 1.0}, {"source": "design_calibrated_plate", "ta