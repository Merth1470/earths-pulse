SIGN.md", "source_location": "Source Record panel surfaces record metadata rather than collapsing layers", "weight": 1.0}, {"source": "design_sonification_transport", "target": "product_stage_1_scope", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "DESIGN.md", "source_location": "Transport is offline in Stage 1", "weight": 1.0}, {"source": "design_no_pixel_sampling_as_measurement", "target": "design_calibrated_plate", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md", "source_location": "Do's and Don'ts: don't imply data we do not have", "weight": 1.0}, {"source": "design_no_pixel_sampling_as_measurement", "target": "docs_data_source_report_pixel_color_rule", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "DESIGN.md", "source_location": "Same prohibition stated as a design rule and as a data-handling rule", "weight": 1.0}], "hyperedges": [{"id": "design_system_named_rules", "label": "Design System Named Rules Discipline", "nodes": ["design_one_signal_rule", "design_hairline_rule", "design_measurement_mono_rule", "design_quiet_heading_rule", "design_single_lift_rule"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md"}]}