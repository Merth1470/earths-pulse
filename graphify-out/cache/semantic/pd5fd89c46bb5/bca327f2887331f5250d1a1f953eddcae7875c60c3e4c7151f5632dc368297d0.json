{"nodes": [{"id": "impeccable_review_focus_skip", "label": "Explore View \u2014 Desktop with Skip-to-Content Link Focused", "file_type": "image", "source_file": ".impeccable/review/focus-skip.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "impeccable_review_focus_skip_plate_01_global", "label": "Plate 01 / Global \u2014 Rendered Visualization Panel (2048x1024)", "file_type": "concept", "source_file": ".impeccable/review/focus-skip.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Framed with corner registration marks and a 'RENDERED VISUALIZATION - NOT LIVE' label so the plate reads as a museum-style plate/record rather than a live data viewport."}, {"id": "impeccable_review_focus_skip_source_record", "label": "Source Record Card \u2014 VERIFIED (SVS 3912, ECCO2 MITgcm, NASA SVS)", "file_type": "concept", "source_file": ".impeccable/review/focus-skip.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A key/value record (visualization, record ID, publisher, model, period, credit, plate frame, plate file) plus 'Open NASA record' external link and a 'Validated 14 Nov 2026' stamp makes provenance auditable and machine-checkable."}, {"id": "impeccable_review_focus_skip_read_plate_as_rendering", "label": "Read the Plate as a Rendering \u2014 Callout ('Pixel colors are not measurements')", "file_type": "rationale", "source_file": ".impeccable/review/focus-skip.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Design intent: separate the scientific artifact (numerical ECCO2 fields, not connected at this stage) from the raster that ships (a rendered visualization), preventing the expressive color ramp from being read as measured data. The callout is a deliberate honesty device, not decoration."}, {"id": "impeccable_review_focus_skip_skip_to_main_content", "label": "SKIP TO MAIN CONTENT \u2014 Focused Skip Link", "file_type": "concept", "source_file": ".impeccable/review/focus-skip.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "High-contrast cyan block armed on :focus-visible, overlaying the masthead \u2014 keyboard-only entry point that bypasses the Explore/About/Data Sources nav; the capture exists specifically to evidence visible focus styling."}, {"id": "impeccable_review_focus_skip_desktop_split", "label": "Desktop Layout \u2014 Wide Plate with Right Rail (Source Record + Signal Path)", "file_type": "concept", "source_file": ".impeccable/review/focus-skip.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Desktop demotes the plate to part of a two-column composition with a fixed right rail, keeping metadata visible alongside the image instead of below the fold."}, {"id": "impeccable_review_focus_skip_cache_disabled_toast", "label": "'Cache disabled' Dev Toast (Bottom-Left)", "file_type": "image", "source_file": ".impeccable/review/focus-skip.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Review-environment artifact rather than product chrome \u2014 indicates the capture was taken with the dev cache off, useful for interpreting why this frame predates the later mobile captures."}, {"id": "impeccable_review_focus_skip_liveness_honesty_principle", "label": "Liveness Honesty Principle \u2014 Status Labels Everywhere Instead of Implied Capability", "file_type": "rationale", "source_file": ".impeccable/review/focus-skip.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recurring design decision across the Explore view: every affordance carries its own truthful status (NOT LIVE, OFFLINE, NOT CONNECTED, PENDING, NOT IMPLEMENTED, VERIFIED) so the product can ship an unfinished sonification stage without overstating what is measured, rendered, or audible."}], "edges": [{"source": "impeccable_review_focus_skip", "target": "impeccable_review_focus_skip_skip_to_main_content", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".impeccable/review/focus-skip.png", "source_location": null, "weight": 1.0}, {"source": "impeccable_review_focus_skip", "target": "impeccable_review_focus_skip_plate_01_global", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".impeccable/review/focus-skip.png", "source_location": null, "weight": 1.0}, {"source": "impeccable_review_focus_skip", "target": "impeccable_review_focus_skip_source_record", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".impeccable/review/focus-skip.png", "source_location": null, "weight": 1.0}, {"source": "impeccable_review_focus_skip", "target": "impeccable_review_explore_tablet_2_signal_path", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".impeccable/review/focus-skip.png", "source_location": null, "weight": 1.0}, {"source": "impeccable_review_focus_skip", "target": "impeccable_review_focus_skip_read_plate_as_rendering", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".impeccable/review/focus-skip.png", "source_location": null, "weight": 1.0}, {"source": "impeccable_review_focus_skip", "target": "impeccable_review_focus_skip_desktop_split", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".impeccable/review/focus-skip.png", "source_location": null, "weight": 1.0}, {"source": "impeccable_review_focus_skip", "target": "impeccable_review_focus_skip_cache_disabled_toast", "relation": "references", "confidence": "EXTR