{"nodes": [{"id": "public_assets_nasa_ecco2_global_currents_sst_2048", "label": "ECCO2 Global Currents + SST Still (2048x1024)", "file_type": "image", "source_file": "public/assets/nasa/ecco2-global-currents-sst-2048.jpg", "source_location": null, "source_url": null, "captured_at": "14 Nov 2026", "author": "NASA Scientific Visualization Studio / Greg Shirah", "contributor": null}, {"id": "public_assets_nasa_ecco2_global_currents_sst_2048_flat_equirectangular_render", "label": "Flat Equirectangular Global Map Render", "file_type": "concept", "source_file": "public/assets/nasa/ecco2-global-currents-sst-2048.jpg", "source_location": null, "source_url": null, "captured_at": "14 Nov 2026", "author": null, "contributor": null, "rationale": "A single flat (equirectangular) world frame rather than an interactive globe: the project is a static, prerendered page, so a wrapped 2D projection at 2:1 aspect (2048x1024) gives a simple background plate that scales to any viewport without a WebGL sphere."}, {"id": "public_assets_nasa_ecco2_global_currents_sst_2048_current_filament_field", "label": "Surface Current Filament / Particle-Trace Field", "file_type": "concept", "source_file": "public/assets/nasa/ecco2-global-currents-sst-2048.jpg", "source_location": null, "source_url": null, "captured_at": "14 Nov 2026", "author": null, "contributor": null, "rationale": "Ocean flow is drawn as dense white-line particle streaks rather than vector arrows or a raster heat map, because the flowing texture is what makes current direction and shear legible at a glance in a still frame."}, {"id": "public_assets_nasa_ecco2_global_currents_sst_2048_sea_surface_temperature_coloring", "label": "Sea Surface Temperature Color Encoding", "file_type": "concept", "source_file": "public/assets/nasa/ecco2-global-currents-sst-2048.jpg", "source_location": null, "source_url": null, "captured_at": "14 Nov 2026", "author": null, "contributor": null, "rationale": "Current speed is encoded as line density and temperature as hue (dark blue -> cyan -> green -> yellow -> orange -> red), so one channel carries motion and the other carries heat without a separate legend image."}, {"id": "public_assets_nasa_ecco2_global_currents_sst_2048_equatorial_warm_band", "label": "Equatorial Warm-Water Band", "file_type": "concept", "source_file": "public/assets/nasa/ecco2-global-currents-sst-2048.jpg", "source_location": null, "source_url": null, "captured_at": "14 Nov 2026", "author": null, "contributor": null}, {"id": "public_assets_nasa_ecco2_global_currents_sst_2048_western_boundary_currents", "label": "Western Boundary Currents (Gulf Stream, Kuroshio)", "file_type": "concept", "source_file": "public/assets/nasa/ecco2-global-currents-sst-2048.jpg", "source_location": null, "source_url": null, "captured_at": "14 Nov 2026", "author": null, "contributor": null}, {"id": "public_assets_nasa_ecco2_global_currents_sst_2048_antarctic_circumpolar_current", "label": "Southern Ocean / Antarctic Circumpolar Band", "file_type": "concept", "source_file": "public/assets/nasa/ecco2-global-currents-sst-2048.jpg", "source_location": null, "source_url": null, "captured_at": "14 Nov 2026", "author": null, "contributor": null}, {"id": "public_assets_nasa_ecco2_global_currents_sst_2048_mesoscale_eddy_swirls", "label": "Mesoscale Eddies and Agulhas Rings", "file_type": "concept", "source_file": "public/assets/nasa/ecco2-global-currents-sst-2048.jpg", "source_location": null, "source_url": null, "captured_at": "14 Nov 2026", "author": null, "contributor": null}, {"id": "public_assets_nasa_ecco2_global_currents_sst_2048_gray_bathymetry_backdrop", "label": "Dark Gray Continent / Bathymetry Backdrop", "file_type": "concept", "source_file": "public/assets/nasa/ecco2-global-currents-sst-2048.jpg", "source_location": null, "source_url": null, "captured_at": "14 Nov 2026", "author": null, "contributor": null, "rationale": "Land is rendered as a desaturated dark gray plate (GTOPO30-derived) rather than satellite imagery, so the colored ocean remains the only saturated element and the continents read as negative space."}, {"id": "public_assets_nasa_ecco2_global_currents_sst_2048_ecco2_model_dataset", "label": "ECCO2 High Resolution Ocean and Sea Ice Model (MITgcm)", "file_type": "concept", "source_file": "public/assets/nasa/ecco2-global-currents-sst-2048.jpg", "source_location": null, "source_url": "https://svs.gsfc.nasa.gov/vis/a000000/a003900/a003912/", "captured_at": "14 Nov 2026", "author": null, "contributor": null}, {"id": "public_assets_nasa_ecco2_global_currents_sst_2048_static_snapshot_frame_25000", "label": "Single Animation Frame (19 Jun 2007 12:00Z)", "file_type": "concept", "source_file": "public/assets/nasa/ecco2-global-currents-sst-2048.jpg", "source_location": null, "source_url": null, "captured_at": "14 Nov 2026", "author": null, "contributor": null, "rationale": "Only one decoded frame is shipped instead of the source animation: it keeps the page's payload at a single ~1 MB JPEG and avoids any live or video dependency, at the cost of freezing a 2007 state that must be labelled as 'not a live view'."}], "edges": [{"source": "public_assets_nasa_ecco2_global_currents_sst_2048", "target": "public_assets_nasa_ecco2_global_currents_sst_2048_flat_equirectangular_render", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/assets/nasa/ecco2-global-currents-sst-2048.jpg", "source_location": null, "weight": 1.0}, {"source": "public_assets_nasa_ecco2_global_currents_sst_2048", "target": "public_assets_nasa_ecco2_global_currents_sst_2048_current_filament_field", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/assets/nasa/ecco2-global-currents-sst-2048.jpg", "source_location": null, "weight": 1.0}, {"source": "public_assets_nasa_ecco2_global_currents_sst_2048", "target": "public_assets_nasa_ecco2_global_currents_sst_2048_sea_surface_temperature_coloring", "relation": "refe