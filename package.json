{
  "name": "earths-pulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify:data": "node scripts/verify-ocean-data.mjs",
    "verify:mapping": "node --no-warnings --experimental-strip-types scripts/verify-sonification.mjs",
    "verify": "npm run verify:data && npm run verify:mapping && npm run verify:carbon && npm run verify:carbon-mapping && npm run verify:air && npm run verify:air-mapping",
    "fetch:carbon": "node scripts/build-carbon-data.mjs",
    "fetch:air": "node scripts/build-air-quality-data.mjs",
    "verify:carbon": "node scripts/verify-carbon-data.mjs",
    "verify:air": "node scripts/verify-air-quality-data.mjs",
    "verify:carbon-mapping": "node --no-warnings --experimental-strip-types scripts/verify-carbon-sonification.mjs",
    "verify:air-mapping": "node --no-warnings --experimental-strip-types scripts/verify-air-sonification.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
